# рантайм / кэш
.claude/
__pycache__/
*.pyc
*.log

# Веса моделей — воспроизводятся обучением, в git им не место. Шаблон без
# пути: правило models/*.pt закрывало только корень, и подпапка models/comp/
# проехала мимо — 60 чекпойнтов на 1 ГБ ушли в историю репозитория.
*.pt
report/
second_date/
# дампы предсказаний — воспроизводятся bench_run.py по чекпойнтам models/,
# слишком тяжёлые для обычного git (см. metrics_*.csv рядом — числа из них уже сохранены)
data/dump_*.npz
# Годовые ряды станций и любые их копии — пересобираются целиком через
# bench_data.py (XML -> bench_prep -> bench_gin -> bench_align), а состояние
# фиксируется в DATA_MANIFEST.json, который в git ЕСТЬ. Шаблон широкий
# намеренно: data/*_20??.npz не ловил ARS_2024_before_align.npz, и 62 резервные
# копии на 500 МБ ушли в историю.
data/**/*.npz

# копия полученных рисунков для просмотра/пересылки (оригиналы — в figures/)
pictures/

# генератор отчёта — не отслеживается по решению автора (меняется при каждой
# правке текста отчёта; сам отчёт в report/ тоже не в git)
scripts/bench_report.py
